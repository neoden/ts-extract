{
  "manifest_version": 3,
  "name": "YouTube Transcript Copy",
  "version": "0.1.0",
  "description": "Копирует транскрипт текущего YouTube-видео в буфер обмена по клику на иконку.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Скопировать транскрипт" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T" }
    }
  }
}
